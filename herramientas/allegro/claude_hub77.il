; clip package silkscreen off pads, U1 corner marks + pin-1 dot, move pin-1 asterisks (Claude) - generated by clip2/gen77
CQDIR = "C:/Users/Maria Priscila Quiro/OneDrive/Documentos/Escritorio/Orcad/cdssetup/workspace/projects/hub/"
cqLog77 = nil
cqSym77 = makeTable("cqSym77" nil)
foreach(s axlDBGetDesign()->symbols when(s->refdes cqSym77[s->refdes] = s))
procedure(cqNear(a b) and(abs(car(a)-car(b)) < 0.006 abs(cadr(a)-cadr(b)) < 0.006))
procedure(cqSegMatch(se tg) or(and(cqNear(car(se) car(tg)) cqNear(cadr(se) cadr(tg))) and(cqNear(car(se) cadr(tg)) cqNear(cadr(se) car(tg)))))
procedure(cqLine77(a b w)
  let((p r) p = axlPathStart(list(a) w) axlPathLine(p w b)
    r = car(errset(axlDBCreatePath(p "BOARD GEOMETRY/SILKSCREEN_TOP" nil nil) t))
    unless(r cqLog77 = cons(sprintf(nil "LINE-FAIL %L %L" a b) cqLog77)) r))
; delete path/line children of ref matching any target segment; re-create untargeted sibling segments
procedure(cqDelSeg77(ref tgs)
  let((s segs keep)
    s = cqSym77[ref]
    when(s foreach(c s->children
      when(c->layer == "PACKAGE GEOMETRY/SILKSCREEN_TOP" && member(c->objType list("path" "line" "arc"))
        segs = if(c->objType == "path" c->segments list(c))
        when(exists(sg segs exists(tg tgs cqSegMatch(sg->startEnd tg)))
          foreach(sg segs
            unless(exists(tg tgs cqSegMatch(sg->startEnd tg))
              if(sg->objType == "arc" then cqLog77 = cons(sprintf(nil "ARC-SIBLING %s %L" ref sg->startEnd) cqLog77)
              else cqLine77(car(sg->startEnd) cadr(sg->startEnd) if(sg->width > 0 sg->width 0.15)) cqLog77 = cons(sprintf(nil "SIBLING %s %L" ref sg->startEnd) cqLog77))))
          cqLog77 = cons(sprintf(nil "DELPATH %s n=%d" ref length(segs)) cqLog77) axlDeleteObject(c)))))))
procedure(cqDelShape77(ref bb)
  let((s) s = cqSym77[ref]
    when(s foreach(c s->children
      when(c->layer == "PACKAGE GEOMETRY/SILKSCREEN_TOP" && !member(c->objType list("path" "line" "arc" "text")) && cqNear(car(c->bBox) car(bb)) && cqNear(cadr(c->bBox) cadr(bb))
        cqLog77 = cons(sprintf(nil "DELSHAPE %s %L" ref c->objType) cqLog77) axlDeleteObject(c))))))
procedure(cqMoveTxt77(ref txt dx dy)
  let((s) s = cqSym77[ref]
    when(s foreach(c s->children
      when(c->objType == "text" && c->text == txt && c->layer == "PACKAGE GEOMETRY/SILKSCREEN_TOP"
        axlTransformObject(c ?move list(dx dy)) cqLog77 = cons(sprintf(nil "MOVETXT %s %s" ref txt) cqLog77))))))
procedure(cqRun77()
 let((p)
  cqDelShape77("J12" list(list(84.0500 100.0000) list(93.9500 110.0000)))
