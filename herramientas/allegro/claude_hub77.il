  axlShell("drc update")
  p = outfile(strcat(CQDIR "claude_c77.txt"))
  foreach(x reverse(cqLog77) fprintf(p "%s\n" x))
  fprintf(p "NDRC %d\n" length(axlDBGetDesign()->drcs))
  close(p) printf("run77 done log=%d\n" length(cqLog77)) t))
cqRun77()
